{
  "meta": {
    "system": "Billet",
    "version": 1,
    "source": "ui-ux-design-system.md"
  },
  "color": {
    "void": "#131110",
    "billet": "#1D1A17",
    "recess": "#0C0B0A",
    "hairline": "#332F2A",
    "ink": "#EDE7DE",
    "ink2": "#A79E93",
    "ink3": "#6B645B",
    "graphite": "#4A463F",
    "bronze": "#8A6F4B",
    "brass": "#C79A63",
    "brassBright": "#EAD3A6",
    "oxide": "#B4574E",
    "spotify": "#1DB954"
  },
  "type": {
    "family": "Instrument Sans",
    "styles": {
      "heroMs": { "size": 76, "weight": 300, "trackingPct": -2, "tabular": true },
      "heroUnit": { "size": 17, "weight": 500 },
      "title": { "size": 28, "weight": 500, "trackingPct": -1 },
      "subtitle": { "size": 16, "weight": 400 },
      "body": { "size": 15, "weight": 400, "lineHeight": 1.5 },
