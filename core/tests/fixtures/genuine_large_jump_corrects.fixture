# CORE-07 fixture. See docs/core07-review.md for the full grammar.
#
# The companion case to phantom_large_fix_held: the true error genuinely
# does step to ~1200 ms (the room seeks) and stays there. The large-
# correction hold must still fire once a second fix corroborates it, and
# the loop must re-converge. Data-driven twin of test_policy.cpp's
# test_closed_loop_genuine_large_jump_corrects.

name: genuine_large_jump_corrects
desc: True error steps from 0 to 1200 ms mid-session (the room re-seeks); the corroboration hold must fire exactly once and the loop must re-converge.
tags: ctl-03,large-correction
snr_db: 18
source: synthetic (mirrors test_policy.cpp's genuine-jump simulation)

mode: world
world.true_error0_ms: 0
world.drift_ms_per_s: 0
world.step_at_s: 500
world.step_to_ms: 1200
world.local_start_ms: 60000

fixes.schedule: explicit
fixes.continue_auto: true
fixes.noise_ms: 3
fixes.confidence: 0.9
fixes.apply_seeks: true

# t_s   confidence  noise_ms
FIX 1.0     0.9   3
FIX 1000.0  0.9   3

horizon_s: 1400

expect.track_lost: false
expect.min_large_seeks: 1
expect.max_large_seeks: 1
expect.final_abs_error_ms_max: 25
expect.min_fixes: 5
