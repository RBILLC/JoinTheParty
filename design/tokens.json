    "wheelDetent": { "intensity": 0.4, "sharpness": 0.9 },
    "wheelCoarse": { "intensity": 0.7, "sharpness": 0.7 },
    "lockThunk": { "intensity": 1.0, "sharpness": 0.15 },
    "lockLost": { "intensity": 0.35, "sharpness": 0.4 },
    "abClick": { "intensity": 0.6, "sharpness": 1.0 },
    "endStop": { "intensity": 0.8, "sharpness": 0.6 }
  },
  "wheel": {
    "detentMs": 5,
    "detentTravelPt": 9,
    "coarseStepMs": 50,
    "rangeMs": 750,
    "commitDebounceMs": 400
